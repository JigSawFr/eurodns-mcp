{
  "name": "eurodns-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the EuroDNS User API — domains, DNS zones, subscriptions and SSL.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "eurodns",
    "dns",
    "domains",
    "registrar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JigSawFr/eurodns-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/JigSawFr/eurodns-mcp/issues"
  },
  "homepage": "https://github.com/JigSawFr/eurodns-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "eurodns-mcp": "dist/index.js",
    "eurodns-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "spec/openapi.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "tsx scripts/gen-operations.ts",
    "prepare": "npm run build",
    "build": "npm run gen && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
