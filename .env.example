# EuroDNS credentials — required. Create them in the EuroDNS dashboard under API access,
# and allowlist the public IP of the machine running this server in the same place.
EURODNS_APP_ID=
EURODNS_API_KEY=

# Guardrails. Both default to false: operations that cost money or cannot be undone are
# refused until explicitly enabled.
# EURODNS_READ_ONLY=false
# EURODNS_ALLOW_BILLING=false
# EURODNS_ALLOW_DESTRUCTIVE=false

# Audit log. "stdout" is refused under stdio, where it carries the JSON-RPC stream.
# EURODNS_AUDIT_DESTINATION=stderr
# EURODNS_AUDIT_FILE=

# Expose the action history as a tool. Requires the "file" destination, needs the
# eurodns.audit scope, and in "own" mode shows a caller only their own actions.
# EURODNS_AUDIT_QUERY=off

# Optional: read any EURODNS_* value from 1Password instead of setting it here. Set the
# variable to a reference such as op://Infra/EuroDNS API/credential. No dependency is added,
# and an environment with no references never contacts 1Password.
# OP_CONNECT_HOST=https://op-connect.internal:8080
# OP_CONNECT_TOKEN=

# HTTP transport only.
# HOST=127.0.0.1
# PORT=3000
# EURODNS_ALLOWED_ORIGINS=https://app.example.com

# Authentication: "oauth", "token", or "none" (loopback development only).
# EURODNS_MCP_AUTH=token
# EURODNS_MCP_TOKEN=
# EURODNS_MCP_TOKEN_LABEL=ci-runner

# OAuth mode. The audience defaults to EURODNS_MCP_PUBLIC_URL and must match the identifier
# the authorization server mints tokens for.
# EURODNS_MCP_PUBLIC_URL=https://mcp.example.com/mcp
# EURODNS_OAUTH_ISSUER=https://issuer.example.com
# EURODNS_OAUTH_AUDIENCE=
# EURODNS_OAUTH_JWKS_URI=
# EURODNS_OAUTH_SUBJECT_CLAIM=sub
# EURODNS_OAUTH_SCOPE_CLAIM=
