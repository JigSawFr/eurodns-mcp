# EuroDNS credentials — required. Create them in the EuroDNS dashboard under API access,
# and allowlist the public IP of the machine running this server in the same place.
EURODNS_APP_ID=
EURODNS_API_KEY=

# Guardrails. Both default to false: operations that cost money or cannot be undone are
# refused until explicitly enabled.
# EURODNS_READ_ONLY=false
# EURODNS_ALLOW_BILLING=false
# EURODNS_ALLOW_DESTRUCTIVE=false
#
# A disabled class is hidden, not advertised-and-refused: the startup line names what is
# hidden and the variable that reveals it.

# Ask the caller to confirm before an operation runs: "off", "destructive" or "all".
# A guard against accidents, not authorisation — the answer comes from the client and is
# never proven to come from a person, so the switches above still decide what is possible.
# A 2025-era client on the HTTP transport cannot carry the exchange and is refused instead.
# EURODNS_CONFIRM=off

# How long the account's domain list is held to answer completion — the suggestions offered
# as a domain name is typed. Concurrent lookups share one upstream call, so a full portfolio
# search does not run per keystroke. eurodns_portfolio_refresh re-reads it on demand.
# EURODNS_PORTFOLIO_TTL_MS=600000

# Adds two extra read-only tools named exactly "search" and "fetch", which some clients
# require before they will install a server. Off by default because those two names are
# unprefixed and can collide with another server's in a client with several connected —
# every other tool here is prefixed eurodns_ precisely to avoid that.
# EURODNS_COMPAT_TOOLS=false

# Audit log. "stdout" is refused under stdio, where it carries the JSON-RPC stream.
# EURODNS_AUDIT_DESTINATION=stderr
# EURODNS_AUDIT_FILE=

# Expose the action history as a tool. Requires the "file" destination, needs the
# eurodns.audit scope, and in "own" mode shows a caller only their own actions.
# EURODNS_AUDIT_QUERY=off

# The log is created mode 0600 and rotates to <file>.1 at this size, keeping two
# generations. The history query reads across both.
# EURODNS_AUDIT_MAX_BYTES=67108864

# Optional: read any EURODNS_* value from 1Password instead of setting it here. Set the
# variable to a reference such as op://Infra/EuroDNS API/credential. No dependency is added,
# and an environment with no references never contacts 1Password.
# OP_CONNECT_HOST=https://op-connect.internal:8080
# OP_CONNECT_TOKEN=

# HTTP transport only.
# HOST=127.0.0.1
# PORT=3000
# EURODNS_ALLOWED_ORIGINS=https://app.example.com

# Body size ceiling, enforced before authentication so an unauthenticated caller cannot
# hand the parser an arbitrarily large document.
# EURODNS_MAX_BODY_BYTES=1048576

# Prometheus metrics on GET /metrics, with this value as the required bearer token. Unset
# means no such endpoint. Its own secret on purpose: a monitoring system should not hold a
# credential that can also change DNS.
# EURODNS_METRICS_TOKEN=            # openssl rand -hex 32

# Rate limit on /mcp only — /healthz and /metrics are polled continuously by machines doing
# their job and are deliberately not limited. Set EURODNS_RATE_LIMIT=0 to turn it off.
# EURODNS_RATE_LIMIT=300
# EURODNS_RATE_LIMIT_WINDOW_MS=60000
#
# Behind a reverse proxy, req.ip is the proxy's, so the limiter would count every caller
# together. Set this to the number of proxies you actually control, and only then.
# EURODNS_TRUST_PROXY=0

# Authentication: "oauth", "token", or "none" (loopback development only).
# EURODNS_MCP_AUTH=token
# EURODNS_MCP_TOKEN=
# EURODNS_MCP_TOKEN_LABEL=ci-runner

# OAuth mode. The audience defaults to EURODNS_MCP_PUBLIC_URL and must match the identifier
# the authorization server mints tokens for.
# EURODNS_MCP_PUBLIC_URL=https://mcp.example.com/mcp
# EURODNS_OAUTH_ISSUER=https://issuer.example.com
# EURODNS_OAUTH_AUDIENCE=
# EURODNS_OAUTH_JWKS_URI=
# EURODNS_OAUTH_SUBJECT_CLAIM=sub
# EURODNS_OAUTH_SCOPE_CLAIM=
#
# Set this to the claim naming what each *person* was assigned — `roles` under Microsoft
# Entra ID — and a caller needs both: the scope in the token and the matching assignment.
# Left unset, the token's scopes are the whole test. See docs/entra-id.md.
# EURODNS_OAUTH_ROLE_CLAIM=
#
# A prefix the identity provider forces onto those role names, stripped before comparing.
# Entra ID needs one: an application keeps app roles and delegated scopes in a single
# namespace, so a role cannot reuse a scope's name. Name them `role.eurodns.read` and set
# this to `role.`.
# EURODNS_OAUTH_ROLE_PREFIX=
#
# Signature algorithms accepted. The default is every asymmetric algorithm and no symmetric
# one; narrow it to what your authorization server actually issues.
# EURODNS_OAUTH_ALGORITHMS=RS256

# --- Container deployment -------------------------------------------------------------
# Inside a container the server listens on 0.0.0.0, and it refuses to start on a
# non-loopback address without authentication. EURODNS_MCP_AUTH is therefore mandatory.
# HOST=0.0.0.0
# PORT=3000
# EURODNS_MCP_AUTH=token
# EURODNS_MCP_TOKEN=            # openssl rand -hex 32
#
# The history query tool reads the log back, so it needs a file on a persistent volume.
# EURODNS_AUDIT_DESTINATION=file
# EURODNS_AUDIT_FILE=/data/audit.jsonl
# EURODNS_AUDIT_QUERY=own
